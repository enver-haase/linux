# SPDX-License-Identifier: GPL-2.0
# Minimal defconfig for Subleq
#
# Subleq is a 32-bit NOMMU OISC with no hardware peripherals beyond
# framebuffer, timer interrupts, and putchar/getchar character I/O.
# This defconfig explicitly disables hardware-dependent subsystems
# to prevent Kconfig defaults from pulling in dead code.

# CONFIG_MMU is not set
# CONFIG_SMP is not set
CONFIG_SUBLEQ=y

# IPC - needed for POSIX shared memory, semaphores, message queues
CONFIG_SYSVIPC=y

# Basic kernel features
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y
CONFIG_BUG=y
# CONFIG_MODULES is not set
# CONFIG_BLOCK is not set

# Preemption - full preemption for debugging
CONFIG_PREEMPT=y

# Enable POSIX timers (experiment)
CONFIG_POSIX_TIMERS=y

# Timer frequency
CONFIG_HZ_100=y

# Minimal required options
CONFIG_SYSFS=y
CONFIG_PROC_FS=y

# File systems
# CONFIG_EXT2_FS is not set
# CONFIG_EXT4_FS is not set
CONFIG_TMPFS=y

# Device and initramfs support
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_INITRAMFS_SOURCE="../initramfs_root ../initramfs_setup.txt"
CONFIG_INITRAMFS_ROOT_UID="squash"
CONFIG_INITRAMFS_ROOT_GID="squash"
CONFIG_INITRAMFS_COMPRESSION_NONE=y

# Networking support
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IP_MULTICAST=y
# CONFIG_IP_ADVANCED_ROUTER is not set
# CONFIG_IP_PNP is not set
# CONFIG_NET_IPIP is not set
# CONFIG_NET_IPGRE_DEMUX is not set
# CONFIG_SYN_COOKIES is not set
# CONFIG_INET_AH is not set
# CONFIG_INET_ESP is not set
# CONFIG_INET_IPCOMP is not set
# CONFIG_INET_DIAG is not set
CONFIG_TCP_CONG_CUBIC=y
CONFIG_DEFAULT_TCP_CONG="cubic"
# CONFIG_IPV6 is not set
# CONFIG_NETWORK_SECMARK is not set
# CONFIG_NETFILTER is not set

# Per-process I/O accounting (for htop DISK R/W columns via /proc/<pid>/io)
# CONFIG_TASKSTATS is not set
# CONFIG_TASK_XACCT is not set
# CONFIG_TASK_IO_ACCOUNTING is not set

# Loopback device (required for 127.0.0.1)
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_DUMMY=y
# CONFIG_ETHERNET is not set
# CONFIG_PHYLIB is not set
# CONFIG_PPP is not set
# CONFIG_SLIP is not set

# Wireless (no WiFi hardware exists)
# CONFIG_WIRELESS is not set
# CONFIG_WLAN is not set

# Networking extras (no real NIC)
# CONFIG_ETHTOOL_NETLINK is not set

# Binary format support (using custom binfmt_elf_subleq.c)
# CONFIG_BINFMT_FLAT is not set

# Core dump (no debugger or disk to consume them)
# CONFIG_COREDUMP is not set
# CONFIG_ELF_CORE is not set

# No drivers
# CONFIG_SERIAL_8250 is not set

# Virtual terminal and framebuffer console
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
# CONFIG_VT_HW_CONSOLE_BINDING is not set
# CONFIG_HW_CONSOLE is not set
# CONFIG_LEGACY_PTYS is not set
# CONFIG_CONSOLE_TRANSLATIONS is not set
# CONFIG_LEGACY_TIOCSTI is not set
CONFIG_UNIX98_PTYS=y

# Framebuffer
CONFIG_FB_CORE=y
CONFIG_FB=y
CONFIG_FB_NOTIFY=y
CONFIG_FB_SUBLEQ=y

# Framebuffer console
CONFIG_DUMMY_CONSOLE=y
CONFIG_DUMMY_CONSOLE_COLUMNS=100
CONFIG_DUMMY_CONSOLE_ROWS=32
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
# CONFIG_FRAMEBUFFER_CONSOLE_LEGACY_ACCELERATION is not set
CONFIG_FONT_SUPPORT=y
CONFIG_FONT_8x16=y
CONFIG_FONTS=y

# Early console
CONFIG_EARLY_PRINTK=y

# Command line - use tty0 for framebuffer console, ttyS0 for text/serial console
CONFIG_CMDLINE="console=tty0 loglevel=7"
CONFIG_CMDLINE_FORCE=y

# Disable debugging (too much output)
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_DEBUG_INFO is not set

# Disable unnecessary initramfs compression formats (we use uncompressed)
# CONFIG_RD_GZIP is not set
# CONFIG_RD_BZIP2 is not set
# CONFIG_RD_LZMA is not set
# CONFIG_RD_XZ is not set
# CONFIG_RD_LZO is not set
# CONFIG_RD_LZ4 is not set
# CONFIG_RD_ZSTD is not set

# Disable partition table support (no disk devices)
# CONFIG_MSDOS_PARTITION is not set
# CONFIG_EFI_PARTITION is not set

# Disable unused subsystems
# CONFIG_FW_LOADER is not set

# Input subsystem - custom keyboard.c polling driver, no mouse hardware
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
# CONFIG_KEYBOARD_ATKBD is not set
# CONFIG_INPUT_MOUSE is not set
# CONFIG_SERIO is not set
# CONFIG_INPUT_VIVALDIFMAP is not set
# CONFIG_HID_SUPPORT is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_RUNTIME_TESTING_MENU is not set

# Hardware monitoring (no sensors exist)
# CONFIG_HWMON is not set

# Hardware RNG (entropy comes from clock seeding in time.c)
# CONFIG_HW_RANDOM is not set

# /dev/mem (no benefit, security surface)
# CONFIG_DEVMEM is not set

# Sound card (host-side OPL3 + PCM): /dev/dsp + /dev/opl for fbdoom
CONFIG_SUBLEQ_SOUND=y

# CPU mitigations (Subleq VM has no speculative execution)
# CONFIG_CPU_MITIGATIONS is not set

# Namespaces (not needed unless unshare is used)
# CONFIG_NAMESPACES is not set

# Unnecessary syscall/FS features
# CONFIG_FHANDLE is not set
# CONFIG_ADVISE_SYSCALLS is not set
# CONFIG_CACHESTAT_SYSCALL is not set
# CONFIG_DNOTIFY is not set
# CONFIG_NETWORK_FILESYSTEMS is not set

# Virtualization (no VirtIO/VHost devices)
# CONFIG_VIRTIO_MENU is not set
# CONFIG_VHOST_MENU is not set

# BPF (syscall disabled, core infra not needed)
# CONFIG_BPF is not set

# Memory debugging (runtime overhead)
# CONFIG_SLUB_DEBUG is not set
# CONFIG_DEBUG_MEMORY_INIT is not set

# Default hostname
CONFIG_DEFAULT_HOSTNAME="eternal"
